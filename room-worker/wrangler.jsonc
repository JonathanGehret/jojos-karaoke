{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jojos-karaoke",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // The player PWA is served from the same Worker, so API and WebSockets are same-origin.
  "assets": {
    "directory": "../player/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "Room" },
      { "name": "ACCOUNTS", "class_name": "Accounts" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room", "Accounts"] }],
  "r2_buckets": [{ "binding": "LIBRARY", "bucket_name": "jojos-karaoke-library" }],
  // per-IP limits for a public site (namespace ids are any unique numbers in your account)
  "ratelimits": [
    { "name": "CREATE_LIMIT", "namespace_id": "4101", "simple": { "limit": 5, "period": 60 } },
    { "name": "UPLOAD_LIMIT", "namespace_id": "4102", "simple": { "limit": 10, "period": 60 } },
    { "name": "LOOKUP_LIMIT", "namespace_id": "4103", "simple": { "limit": 20, "period": 60 } }
  ],
  // Custom domain: uncomment after adding the domain to Cloudflare
  // "routes": [{ "pattern": "karaoke.example.com", "custom_domain": true }],
  "observability": { "enabled": true }
  // Secrets (wrangler secret put):
  //   MEDIA_SECRET  random string used to sign media URLs (required)
  //   SIGNUP_CODE   if set, creating a library account requires this code
}
