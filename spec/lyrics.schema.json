{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jojos-karaoke/spec/lyrics.schema.json",
  "title": "Timed lyrics",
  "type": "object",
  "required": ["version", "lines"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "singers": {
      "type": "object",
      "description": "Optional display names per singer id",
      "additionalProperties": { "type": "string" }
    },
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["start", "end", "words"],
        "additionalProperties": false,
        "properties": {
          "start": { "type": "integer", "minimum": 0 },
          "end": { "type": "integer", "minimum": 0 },
          "singer": { "type": "string", "maxLength": 16 },
          "words": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["t", "s", "e"],
              "additionalProperties": false,
              "properties": {
                "t": { "type": "string", "minLength": 1 },
                "s": { "type": "integer", "minimum": 0 },
                "e": { "type": "integer", "minimum": 0 },
                "lowConfidence": { "type": "boolean" }
              }
            }
          }
        }
      }
    }
  }
}
